{
  "manifest_version": 3,
  "name": "BeaconLight",
  "version": "1.0.0",
  "description": "See what data web apps send about you — in plain language. Block or spoof trackers instantly.",
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "storage",
    "activeTab",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "BeaconLight"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/inject.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {}
}
